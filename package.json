{
  "name": "musv-cantonese-course-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --outDir .local/demo-dist",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:security": "node tests/sql/run-security.mjs",
    "test:accounts": "node tests/edge/run-managed-accounts.mjs",
    "check:public": "node scripts/assert-public-build.mjs",
    "prepare:materials": "python scripts/prepare-materials.py"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.7",
    "@phosphor-icons/react": "2.1.10",
    "@pinyin-pro/data": "1.3.1",
    "@supabase/supabase-js": "2.115.0",
    "pinyin-pro": "3.29.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "lighthouse": "13.4.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
